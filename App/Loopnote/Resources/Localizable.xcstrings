    },
    "You can leave the app. Processing continues and its progress appears on the Lock Screen.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan çıkabilirsin. İşlem devam eder, ilerlemesi kilit ekranında görünür."
