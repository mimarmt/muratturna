    },
    "Uses OpenAI's Whisper large-v3 entirely on your iPhone for the most accurate Turkish, English and German meeting transcripts. Download over Wi-Fi; recordings never leave the device.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En isabetli Türkçe, İngilizce ve Almanca toplantı metinleri için OpenAI'nin Whisper large-v3 modelini tamamen iPhone'unda kullanır. Wi-Fi ile indir; kayıtlar cihazdan asla çıkmaz."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt OpenAIs Whisper large-v3 vollständig auf deinem iPhone für die genauesten Meeting-Transkripte auf Türkisch, Englisch und Deutsch. Über WLAN laden; Aufnahmen verlassen das Gerät nie."
          }
        }
      }
    },
