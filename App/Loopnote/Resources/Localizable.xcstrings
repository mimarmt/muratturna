      }
    },
    "Only compact voices for %@. Download an Enhanced voice in Settings › Accessibility › Read & Speak › Voices.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için yalnızca kompakt ses var. Ayarlar › Erişilebilirlik › Oku ve Seslendir › Sesler bölümünden Gelişmiş bir ses indir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
