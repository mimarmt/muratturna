            "value": "Loopnote"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote, notlarını dikte edebilmen için mikrofonu kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote verwendet das Mikrofon, damit du Notizen diktieren kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote uses the microphone so you can dictate notes."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote sesini cihaz üzerinde yazıya döker."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote wandelt deine Stimme auf dem Gerät in Text um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote turns your voice into text on your device."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote uses the camera so you can add a photo to a note."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote, notlara fotoğraf ekleyebilmen için kamerayı kullanır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote verwendet die Kamera, damit du Notizen ein Foto hinzufügen kannst."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote reminds you when you arrive at or leave a place you choose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote, seçtiğin bir yere vardığında veya oradan ayrıldığında sana hatırlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote erinnert dich, wenn du an einem gewählten Ort ankommst oder ihn verlässt."
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Critical notes ring as alarms so you hear them even in Silent mode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritik notlar, sessiz moddayken bile duyabilmen için alarm olarak çalar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritische Notizen klingeln als Wecker, damit du sie auch im Stumm-Modus hörst."
          }
        }
      }
    }
  },
  "version": "1.0"
}