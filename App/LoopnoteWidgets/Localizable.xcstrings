{
  "sourceLanguage": "en",
  "strings": {
    "Record meeting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı kaydet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting aufnehmen"
          }
        }
      }
    },
    "Start recording a meeting in Loopnote.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'ta toplantı kaydını başlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine Meeting-Aufnahme in Loopnote."
          }
        }
      }
    },
    "Voice note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli not"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprachnotiz"
          }
        }
      }
    },
    "Dictate a living note in Loopnote.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'ta canlı bir not dikte et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktiere eine lebendige Notiz in Loopnote."
          }
        }
      }
    },
    "Recording meeting": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı kaydediliyor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting wird aufgenommen"
          }
        }
      }
    },
    "Next note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki not"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächste Notiz"
          }
        }
      }
    },
    "Start meeting recording": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toplantı kaydını başlat"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meeting-Aufnahme starten"
          }
        }
      }
    },
    "Opens Loopnote and starts recording a meeting.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'u açar ve toplantı kaydını başlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Loopnote und startet eine Meeting-Aufnahme."
          }
        }
      }
    },
    "New voice note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni sesli not"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Sprachnotiz"
          }
        }
      }
    },
    "Opens Loopnote and starts dictating a living note.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'u açar ve canlı bir not için dikteyi başlatır."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Loopnote und startet das Diktat einer lebendigen Notiz."
          }
        }
      }
    },
    "Next notes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki notlar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nächste Notizen"
          }
        }
      }
    },
    "The notes Loopnote will read to you next.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'un sana sıradaki okuyacağı notlar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notizen, die Loopnote dir als Nächstes vorliest."
          }
        }
      }
    },
    "No notes": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yok"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Notizen"
          }
        }
      }
    },
    "Add a note in Loopnote and it will appear here.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopnote'a bir not ekle, burada görünsün."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge in Loopnote eine Notiz hinzu, dann erscheint sie hier."
          }
        }
      }
    },
    "Done?": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti mi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erledigt?"
          }
        }
      }
    },
    "Call the municipality about the permit": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhsat için belediyeyi ara"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wegen der Genehmigung beim Bauamt anrufen"
          }
        }
      }
    },
    "Send the facade renders": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cephe görsellerini gönder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fassadenrenderings senden"
          }
        }
      }
    }
  },
  "version": "1.0"
}